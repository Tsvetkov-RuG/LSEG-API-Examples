{
    "logs": {
        "level": "debug",
        "transports": {
            "console": {
                "enabled": false
            },
            "file": {
                "enabled": false,
                "name": "lseg-data-lib.log"
            }
        }
    },
    "sessions": {
        "default": "platform.ldp",
        "platform": {
            "ldp": {
                "app-key": "your_very_secret_app_key",
